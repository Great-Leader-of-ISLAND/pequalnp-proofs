import PEqualNP.CoJunctionFastLeaf4482
namespace CoJunctionFastGrids4482
open CoJunctionFastLeaf4482 CoPortRoots4482 CoBitBlock4482 CoBlockSlots4482 CoJunctionWire4482 CoJunctionTree4482
set_option maxRecDepth 200000
set_option maxHeartbeats 0
structure Grid (n : Nat) where
  inc : Fin n → BitVec (2^n)
  digits : ∀ i (j : Fin (2^n)),(inc i).getLsbD j.val=j.val.testBit i.val
  width : BitVec (2^n)
  enough : ∀ j : Fin (2^n), (members j).card+5≤n → width.getLsbD j.val=true
