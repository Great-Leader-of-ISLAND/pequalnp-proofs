def seedAtom (p : Fin 11) : Atom := operation (geom p) true (rootAtom p 0) (rootAtom p 2)
def inverseAtom (p : Fin 11) : Atom :=
  let a := if h : p.val<9 then rootAtom p ⟨p.val,h⟩ else seedAtom p
  ⟨~~~a.full,(~~~a.pos) &&& (cellMasks p),(~~~a.neg) &&& (cellMasks p),fixedMask (~~~a.full) sliceWords⟩

/-- Mode 10 is the ordinary case. Mode 9 uses the complement of the supplied OR. -/
def root (p : Fin 11) (useSeed : Bool) : State :=
  let raws := List.ofFn (rootAtom p)
  let ws := raws ++ (if useSeed then [seedAtom p] else []) ++ (if p.val=10 then [] else [inverseAtom p])
  ⟨ws,(rootAtom p 0).fixed ||| (rootAtom p 2).fixed⟩

