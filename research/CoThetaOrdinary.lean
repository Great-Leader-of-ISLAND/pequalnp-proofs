def raw7 : List Sig := [x0,x1,x2,x3,x4,x5,x6]
def col (j : Fin 7) : Sig := raw7.getD j.val zero
def raw (j : Fin 7) : List Sig := raw7 ++ [neg (col j)]
def sample (d : Bool) (i : Fin 256) (j : Fin 7) := bit d i (col j)
def theta (x : Fin 7 → Bool) : Bool :=
  (x 0 && x 2) || (x 2 && x 1) || (x 0 && x 3) || (x 3 && x 4) ||
  (x 4 && x 1) || (x 0 && x 5) || (x 5 && x 6) || (x 6 && x 1)
def edgeSig : Sig :=
  (bin true (bin true (bin true (bin true (bin true (bin true (bin true (bin false (col 0) (col 2)) (bin false (col 2) (col 1))) (bin false (col 0) (col 3))) (bin false (col 3) (col 4))) (bin false (col 4) (col 1))) (bin false (col 0) (col 5))) (bin false (col 5) (col 6))) (bin false (col 6) (col 1)))
private theorem edgeSig_eq : edgeSig = target := by decide +kernel

private theorem sample_ok (d : Bool) (i : Fin 256) : theta (sample d i) = d := by
  have h := congrArg (bit d i) edgeSig_eq
  simp only [edgeSig, bit_bin, Bool.false_eq_true, ↓reduceIte] at h
  have ht : bit d i target = d := by
    cases d
    · change (0 : B).getLsbD i.val = false
      simp
    · change (BitVec.allOnes 256).getLsbD i.val = true
      rw [BitVec.getLsbD_allOnes]
      simp
  exact h.trans ht

private theorem sample_list (d : Bool) (i : Fin 256) :
    List.ofFn (sample d i) = raw7.map (bit d i) := by
  have h : List.ofFn col = raw7 := by rfl
  rw [← h, List.map_ofFn]; rfl

theorem circuit_target (j : Fin 7) (C : Circuit) (h : PEqualNP.MetaComplexity.FanInTwo C)
    (he : ∀ x : Fin 7 → Bool, C.eval (List.ofFn x ++ [!(x j)]) = theta x) :
    target ∈ execute C.gates (raw j) := by
  let w := execute C.gates (raw j)
  have project (s i) : bit s i (w.getD C.output zero) = s := by
    rw [←b_read]
    change ((execute C.gates (raw j)).map _).getD C.output false = _
    rw [execute_bits _ _ _ _ (fun g hg => (h g hg).1)]
    have eq := he (sample s i)
    rw [sample_list,sample_ok] at eq
    simpa only [raw,List.map_append,List.map_singleton,bit_neg,sample,Circuit.eval,Circuit.wires] using eq
  have et : w.getD C.output zero = target := by
    apply Prod.ext
    · apply BitVec.eq_of_getLsbD_eq
      intro i hi
      have p := project true ⟨i,hi⟩
      change (w.getD C.output zero).1.getLsbD i = true at p
      change _ = (BitVec.allOnes _).getLsbD _
      simpa only [BitVec.getLsbD_allOnes,hi,decide_true] using p
    · apply BitVec.eq_of_getLsbD_eq
      intro i hi
      have p := project false ⟨i,hi⟩
      change (w.getD C.output zero).2.getLsbD i = false at p
      have hz : (0 : B).getLsbD i=false := by simp
      exact p.trans hz.symm
  have rep := get_rep w C.output
  rw [et] at rep
  exact rep.resolve_right (fun hn => hn target_proper)

/-- The search checks the only possible number of successors at each state,
    and projects no special degree assumption onto these signed inputs. -/
def rejectState (ws : List Sig) (t : Nat) :=
  if unionSep (decide (0<t)) ws = top then !(search 10 t ws) else true

def checkedRoot (j : Fin 7) : Bool :=
  (raw j).sublists.all fun ws => (List.range (12-ws.length)).all fun t => rejectState ws t

private lemma raws_nd (j : Fin 7) : (raw j).Nodup := by fin_cases j <;> decide +kernel

theorem exclusion (j : Fin 7) (cert : checkedRoot j = true) (C : Circuit)
    (hs : C.size ≤ 10) (hf : PEqualNP.MetaComplexity.FanInTwo C) :
    ¬ ∀ x : Fin 7 → Bool, C.eval (List.ofFn x ++ [!(x j)]) = theta x := by
  intro he
  obtain ⟨k,t,S,hk,hl,hsub⟩ := extract C.gates (raw j) hf (circuit_target j C hf he)
  let ws := (raw j).filter fun a => decide (a ∈ S)
  have hsl : ws.Sublist (raw j) := List.filter_sublist
  have hn : ws.Nodup := (raws_nd j).sublist hsl
  have heq : ws.toFinset = S := by
    ext a; simp only [ws,List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
    exact ⟨And.right,fun ha => ⟨hsub a ha, ha⟩⟩
  have hbudget : k ≤ 10 := hk.trans hs
  have hsize := (live_size hl).2
  rw [← heq,List.toFinset_card_of_nodup hn] at hsize
  have hh := List.all_eq_true.mp cert ws (List.mem_sublists.mpr hsl)
  have hc := List.all_eq_true.mp hh t (List.mem_range.mpr (by omega))
  have hy := search_complete (unrestricted hl) 10 hbudget ws hn heq
  simp [rejectState, live_cover hl heq, hy] at hc

/- Inline in the same module as CoThetaCompact, after importing public L_meta_517.
    This cuts any parent frontier consisting of the seven positive raw inputs
    out of all three signed searches using an existing kernel certificate. -/
def index (key : Nat) (j : Fin 256) : Fin 256 := Fin.ofNat 256 ((key >>> (8 * j.val)) &&& 255)

def reindex (f : Fin 256 → Fin 256) (x : B) : B :=
  (BitVec.ofBoolListLE (List.ofFn fun j => x.getLsbD (f j).val)).cast List.length_ofFn

lemma reindex_bit (f : Fin 256 → Fin 256) (a : B) (j : Nat) (hj : j < 256) :
    (reindex f a).getLsbD j = a.getLsbD (f ⟨j,hj⟩).val := by
  rw [reindex, BitVec.getLsbD_cast, BitVec.getLsbD_ofBoolListLE]
  have h : j < (List.ofFn fun x => a.getLsbD (f x).val).length := by simpa only [List.length_ofFn] using hj
  rw [List.getD_eq_getElem?_getD, List.getElem?_eq_getElem h]
  exact List.getElem_ofFn h

lemma reindex_and (f : Fin 256 → Fin 256) (a b : B) :
    reindex f (a &&& b) = reindex f a &&& reindex f b := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  simp only [BitVec.getLsbD_and, reindex_bit _ _ _ hj]

lemma reindex_or (f : Fin 256 → Fin 256) (a b : B) :
    reindex f (a ||| b) = reindex f a ||| reindex f b := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  simp only [BitVec.getLsbD_or, reindex_bit _ _ _ hj]

lemma reindex_not (f : Fin 256 → Fin 256) (a : B) :
    reindex f (~~~a) = ~~~reindex f a := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  simp only [BitVec.getLsbD_not, reindex_bit _ _ _ hj, hj, (f ⟨j,hj⟩).isLt, decide_true, Bool.true_and]

lemma reindex_zero (f : Fin 256 → Fin 256) : reindex f 0 = 0 := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  rw [reindex_bit _ _ _ hj]
  simp

lemma reindex_top (f : Fin 256 → Fin 256) : reindex f top = top := by
  apply BitVec.eq_of_getLsbD_eq
  intro j hj
  simp only [top, reindex_bit _ _ _ hj, BitVec.getLsbD_allOnes, hj, (f ⟨j,hj⟩).isLt, decide_true]


def diagnosticColumns : Fin 256 → Fin 256 := index 

def subSample (a : Sig) : Sig := (reindex diagnosticColumns a.1,reindex diagnosticColumns a.2)
lemma sub_neg (a : Sig) : subSample (neg a) = neg (subSample a) := by simp [subSample,neg,reindex_not]
lemma sub_bin (d : Bool) (a b : Sig) : subSample (bin d a b) = bin d (subSample a) (subSample b) := by
  cases d <;> simp [subSample,bin,reindex_and,reindex_or]
lemma sub_target : subSample target = target := Prod.ext (reindex_top _) (reindex_zero _)

def thetaWord (a : Sig) : Nat :=
  ((a.1.toNat &&& Live514.lo 232) <<< 232) ||| (a.2.toNat &&& Live514.lo 232)

lemma thetaWord_bit (a : Sig) (j : Nat) :
    (thetaWord a).testBit j =
      if j < 232 then a.2.getLsbD j else if j < 464 then a.1.getLsbD (j-232) else false := by
  simp only [thetaWord, Live514.lo, Nat.testBit_or, Nat.testBit_and, BitVec.testBit_toNat,
    Nat.testBit_two_pow_sub_one, Nat.testBit_shiftLeft]
  by_cases hj : j < 232
  · simp [hj, show ¬ 232 ≤ j by omega]
  · by_cases hk : j < 464
    · simp [hj, hk, show 232 ≤ j by omega, show j - 232 < 232 by omega]
    · simp [hj, hk, show 232 ≤ j by omega, show ¬ j - 232 < 232 by omega]

lemma thetaWord_target : thetaWord target = Live514.goal 232 := by decide +kernel

lemma thetaWord_neg (a : Sig) :
    thetaWord (neg a) = thetaWord a ^^^ Live514.mask 232 := by
  apply Nat.eq_of_testBit_eq
  intro j
  rw [Nat.testBit_xor, thetaWord_bit, thetaWord_bit]
  by_cases hl : j < 232
  · simp [hl, neg, Live514.mask, Live514.lo, BitVec.getLsbD_not, show j < 256 by omega,
      show j < 464 by omega]
  · by_cases hh : j < 464
    · simp [hl, hh, neg, Live514.mask, Live514.lo, BitVec.getLsbD_not, show j - 232 < 256 by omega]
    · simp [hl, hh, Live514.mask, Live514.lo]

lemma thetaWord_bin (d : Bool) (a b : Sig) :
    thetaWord (bin d a b) = if d then thetaWord a ||| thetaWord b else thetaWord a &&& thetaWord b := by
  apply Nat.eq_of_testBit_eq
  intro j
  cases d <;> simp only [bin, Bool.false_eq_true, ite_false, ite_true, Nat.testBit_or,
    Nat.testBit_and, thetaWord_bit, BitVec.getLsbD_or, BitVec.getLsbD_and] <;>
    split_ifs <;> rfl

lemma live_run {k t S} (h : Live k t S) (v : List Sig) (hv : v.Nodup)
    (he : v.toFinset = S) :
    Live514.Run neg (bin false) (bin true) target k v := by
  induction h generalizing v with
  | stop =>
    have hp : ([target] : List Sig).Perm v :=
      List.perm_of_nodup_nodup_toFinset_eq (by simp) hv (by simp [he])
    exact Live514.Run.perm hp Live514.Run.done
  | @unary k t U a ha hf tail ih =>
    let rest := dropped [a] v
    have ham : a ∈ v := List.mem_toFinset.mp (he.symm ▸ Finset.mem_insert_self _ _)
    obtain ⟨hn, eq⟩ := edit_list (del := [a]) hv (by simp) (by simpa using he)
    let save := decide (a ∈ U)
    have hkeep : Live514.kept save a rest = keepOf U [a] ++ rest := by
      by_cases hm : a ∈ U <;> simp [save, Live514.kept, keepOf, hm]
    rw [← hkeep] at hn eq
    have hs : (neg a :: Live514.kept save a rest).toFinset = insert (neg a) U := by
      rw [List.toFinset_cons, eq]
    have hnd : (neg a :: Live514.kept save a rest).Nodup := by
      refine List.nodup_cons.mpr ⟨fun hz => hf (Finset.mem_insert_of_mem ?_), hn⟩
      exact eq ▸ List.mem_toFinset.mpr hz
    have p := recover_perm [a] v hv (by simp) (by simpa using ham)
    exact Live514.Run.perm p.symm (Live514.Run.one true save (ih _ hnd hs))
  | @binary k t U a b d ha hb hab hf tail ih =>
    let rest := dropped [a,b] v
    have ah : a ∈ v := List.mem_toFinset.mp (he.symm ▸ Finset.mem_insert_self _ _)
    have bh : b ∈ v := List.mem_toFinset.mp (he.symm ▸ Finset.mem_insert_of_mem (Finset.mem_insert_self _ _))
    obtain ⟨hn, eq⟩ := edit_list (del := [a,b]) hv (by simp [hab]) (by simpa using he)
    let sa := decide (a ∈ U)
    let sb := decide (b ∈ U)
    have hkeep : Live514.kept sa a (Live514.kept sb b rest) = keepOf U [a,b] ++ rest := by
      by_cases ham : a ∈ U <;> by_cases hbm : b ∈ U <;>
        simp [sa, sb, Live514.kept, keepOf, ham, hbm]
    rw [← hkeep] at hn eq
    have hs : (bin d a b :: Live514.kept sa a (Live514.kept sb b rest)).toFinset = insert (bin d a b) U := by
      rw [List.toFinset_cons, eq]
    have hnd : (bin d a b :: Live514.kept sa a (Live514.kept sb b rest)).Nodup := by
      refine List.nodup_cons.mpr ⟨fun hz => hf (Finset.mem_insert_of_mem (Finset.mem_insert_of_mem ?_)), hn⟩
      exact eq ▸ List.mem_toFinset.mpr hz
    have p := recover_perm [a,b] v hv (by simp [hab]) (by simpa using And.intro ah bh)
    have done := ih _ hnd hs
    cases d
    · exact Live514.Run.perm p.symm (Live514.Run.two true sa sb done)
    · exact Live514.Run.perm p.symm (Live514.Run.two false sa sb done)

def map517 (a : Sig) := thetaWord (subSample a)
private lemma map517_target : map517 target = Live514.goal 232 := by rw [map517,sub_target,thetaWord_target]
private lemma map517_neg (a : Sig) : map517 (neg a) = map517 a ^^^ Live514.mask 232 := by
  simp only [map517,sub_neg,thetaWord_neg]
private lemma map517_bin (d : Bool) (a b : Sig) : map517 (bin d a b) =
    if d then map517 a ||| map517 b else map517 a &&& map517 b := by
  simp only [map517,sub_bin,thetaWord_bin]
set_option maxRecDepth 10000 in
private theorem raw_lift : raw7.map map517 = Live514.xs517 := by decide +kernel

theorem ordinary_cut {v : List Sig} {k t : Nat} (hp : v.Sublist raw7) (hk : k ≤ 10) :
    ¬ Restricted k t v.toFinset := by
  intro h
  have hn : raw7.Nodup := by decide +kernel
  have hr := live_run h.live v (hn.sublist hp) rfl
  have ht := Live514.Run.map (inv' := (· ^^^ Live514.mask 232)) (meet' := (· &&& ·))
    (join' := (· ||| ·)) map517 map517_neg (fun a b => map517_bin false a b)
    (fun a b => map517_bin true a b) hr
  rw [map517_target] at ht
  apply Live514.no_sub517 Live514.noRunFull k hk _ _ ht
  rw [← raw_lift]; exact hp.map _

/-- Prepend any legal multi-output computation of the live signals.  The
    movement back through a gate charges at most one operation even when
    the gate is a nullary constant, a copy, or reads an invalid index. -/
private lemma pull_prefix (gs : List Gate) (w : List Sig)
    (legal : ∀ g ∈ gs, g.op ∈ ({GateOp.and,GateOp.or,GateOp.not} : Set GateOp) ∧ g.inputs.length≤2)
    {n t : Nat} {S : Finset Sig} (h : Live n t S) (sub : ∀ a ∈ S, a ∈ execute gs w) :
    ∃ k t' T, k ≤ n + gs.length ∧ Live k t' T ∧ ∀ a ∈ T, a ∈ w := by
  induction gs generalizing w with
  | nil => exact ⟨n,t,S,by simp,h,sub⟩
  | cons g gs ih =>
    obtain ⟨z,u,T,hz,hr,hs⟩ := ih (w ++ [gv w g]) (fun g' hg => legal g' (by simp [hg])) sub
    obtain ⟨q,p,R,hq,hh,hR⟩ := pull_gate hr (gate_rep w g (legal g (by simp))) hs
    exact ⟨q,p,R,by simp; omega,hh,hR⟩

/-- If a signed frontier is cheaply generated from ordinary positive inputs,
    the public theta lower bound rules out its entire remaining subproblem. -/
theorem cheap_prefix_cut (gs : List Gate) (v : List Sig) (k t : Nat)
    (legal : ∀ g ∈ gs, g.op ∈ ({GateOp.and,GateOp.or,GateOp.not} : Set GateOp) ∧ g.inputs.length≤2)
    (generated : ∀ a ∈ v, a ∈ execute gs raw7) (budget : gs.length + k ≤ 10) : Impossible k t v := by
  intro m hm hr
  obtain ⟨q,u,T,hq,hT,hs⟩ := pull_prefix gs raw7 legal hr.live
    (fun a ha => generated a (List.mem_toFinset.mp ha))
  let packed := raw7.filter fun a => decide (a ∈ T)
  have hp : packed.Sublist raw7 := List.filter_sublist
  have he : packed.toFinset = T := by
    ext a
    simp only [packed,List.mem_toFinset,List.mem_filter,decide_eq_true_eq]
    exact ⟨And.right,fun ha => ⟨hs a ha,ha⟩⟩
  exact ordinary_cut hp (by omega : q ≤ 10) (he.symm ▸ unrestricted hT)

end CoThetaOrdinary
