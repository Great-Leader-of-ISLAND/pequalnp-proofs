import PEqualNP.CoMaskShape4482
namespace CoMaskShapeProbe4482
open CoMaskShape4482
set_option maxRecDepth 100000
set_option maxHeartbeats 0
def membership : Fin 11 → BitVec 2048 := ![,,,,,,,,,,]
theorem digit0 : membership 0=ofBits (fun j : Fin 2048 => j.val.testBit 0) := by decide +kernel
theorem digit1 : membership 1=ofBits (fun j : Fin 2048 => j.val.testBit 1) := by decide +kernel
theorem digit2 : membership 2=ofBits (fun j : Fin 2048 => j.val.testBit 2) := by decide +kernel
theorem digit3 : membership 3=ofBits (fun j : Fin 2048 => j.val.testBit 3) := by decide +kernel
theorem digit4 : membership 4=ofBits (fun j : Fin 2048 => j.val.testBit 4) := by decide +kernel
theorem digit5 : membership 5=ofBits (fun j : Fin 2048 => j.val.testBit 5) := by decide +kernel
theorem digit6 : membership 6=ofBits (fun j : Fin 2048 => j.val.testBit 6) := by decide +kernel
theorem digit7 : membership 7=ofBits (fun j : Fin 2048 => j.val.testBit 7) := by decide +kernel
theorem digit8 : membership 8=ofBits (fun j : Fin 2048 => j.val.testBit 8) := by decide +kernel
theorem digit9 : membership 9=ofBits (fun j : Fin 2048 => j.val.testBit 9) := by decide +kernel
theorem digit10 : membership 10=ofBits (fun j : Fin 2048 => j.val.testBit 10) := by decide +kernel
theorem all_membership : ∀ i : Fin 11, ∀ j : Fin 2048,
    (membership i).getLsbD j.val=j.val.testBit i.val := by
  intro i
  fin_cases i <;> intro j <;> simp only [digit0,digit1,digit2,digit3,digit4,digit5,digit6,digit7,digit8,digit9,digit10,ofBits_at]
end CoMaskShapeProbe4482
