def subsetB (a h : Fam) := a.all fun v => h.contains v
def allows (a b h : Fam) (op : Bool) :=
  subsetB a h && subsetB b h && a.all (fun x => b.all (fun y => h.contains (gate op x y)))
def linked (a b h : List Fam) := a.all (fun l => b.all (fun r =>
  [false,true].all (fun op => h.any (fun dst => allows l r dst op))))
def bound (s : Shape) (h : List Fam) := ∃ T∈h, ∀ x∈s.value,x∈T

theorem compose {a b c : List Fam} (legit : linked a b c=true)
    {l r : Shape} (bl : bound l a) (br : bound r b) (op : Bool) : bound (.fork op l r) c := by
  obtain ⟨A,hA,sa⟩ := bl
  obtain ⟨B,hB,sb⟩ := br
  have both := List.all_eq_true.mp (List.all_eq_true.mp legit A hA) B hB
  have hm : op∈[false,true] := by cases op <;> simp
  obtain ⟨T,ht,fits⟩ := List.any_eq_true.mp (List.all_eq_true.mp both op hm)
  simp only [allows,Bool.and_eq_true] at fits
  refine ⟨T,ht,?_⟩
  intro x member
  change x ∈ (l.value ++ r.value ++ l.value.flatMap (fun a => r.value.map (gate op a))).eraseDups at member
  simp only [List.mem_eraseDups,List.mem_append,List.mem_flatMap,List.mem_map] at member
  rcases member with (left|right)|⟨a,ha,b,hb,eq⟩
  · exact List.contains_iff_mem.mp (List.all_eq_true.mp fits.1.1 _ (sa _ left))
  · exact List.contains_iff_mem.mp (List.all_eq_true.mp fits.1.2 _ (sb _ right))
  · subst x
    exact List.contains_iff_mem.mp (List.all_eq_true.mp (List.all_eq_true.mp fits.2 a (sa a ha)) b (sb b hb))

theorem atom_bound (i : Fin 3) : bound (.atom i) cat1 := by
  have ok : cat1.any (fun T => subsetB (Shape.value (.atom i)) T)=true := by
    fin_cases i <;> decide +kernel
  obtain ⟨T,hT,hs⟩ := List.any_eq_true.mp ok
  exact ⟨T,hT,fun x hx => List.contains_iff_mem.mp (List.all_eq_true.mp hs x hx)⟩
