import PEqualNP.CoNine3024FixedMap

namespace CoNine3024.Faces
open CoNine3024Budget CoNine3024FixedMap
abbrev Deck := BitVec 9

structure Corners where
  l0 : Deck
  l1 : Deck
  l2 : Deck
  l3 : Deck
  h0 : Deck
  h1 : Deck
  h2 : Deck
  h3 : Deck
  deriving DecidableEq, BEq

def low (c : Corners) : Fin 4 → Deck := ![c.l0,c.l1,c.l2,c.l3]
def high (c : Corners) : Fin 4 → Deck := ![c.h0,c.h1,c.h2,c.h3]

def step (d : Bool) (a b : Corners) : Corners :=
  let mix : Deck → Deck → Deck := fun x y => if d then x ||| y else x &&& y
  ⟨mix a.l0 b.l0,mix a.l1 b.l1,mix a.l2 b.l2,mix a.l3 b.l3,
    mix a.h0 b.h0,mix a.h1 b.h1,mix a.h2 b.h2,mix a.h3 b.h3⟩

def flags (c : Corners) : Deck :=
  (c.l0 &&& c.l1 &&& c.l2 &&& c.l3) ||| ~~~(c.h0 ||| c.h1 ||| c.h2 ||| c.h3)

