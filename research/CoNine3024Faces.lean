set_option maxRecDepth 16384 in
theorem spread_eq : ∀ d : Deck, spread d=pack (fun j => if d.getLsbD j.val then 1 else 0) := by
  decide +kernel

theorem flags_iff (c : Corners) (j : Fin 9) :
    (flags c).getLsbD j.val=true ↔
    (∀ i : Fin 4,(low c i).getLsbD j.val=true) ∨
    (∀ i : Fin 4,(high c i).getLsbD j.val=false) := by
  have bounds := j.isLt
  simp only [flags,BitVec.getLsbD_or,BitVec.getLsbD_and,BitVec.getLsbD_not,
    bounds,↓reduceIte,Bool.or_eq_true,Bool.and_eq_true,Bool.not_eq_true',Bool.or_eq_false_iff]
  constructor
  · rintro (⟨⟨⟨a,b⟩,d⟩,e⟩|⟨⟨⟨a,b⟩,d⟩,e⟩)
    · left; intro i; fin_cases i <;> assumption
    · right; intro i; fin_cases i <;> assumption
  · rintro (h|h)
    · exact Or.inl ⟨⟨⟨h 0,h 1⟩,h 2⟩,h 3⟩
    · exact Or.inr ⟨⟨⟨h 0,h 1⟩,h 2⟩,h 3⟩

