import Mathlib

/- One shared output over the two missing stars, all ten sources independent.
The certificate uses only singleton and empty complement assignments.
Bit 0 is A, 1,2 are point centers, 3 is their common line, and 4..9 private lines. -/
namespace CoAlarmPort1481

def graph (m : Nat) : Bool := m.testBit 0 ||
  (m.testBit 1 && (m.testBit 3 || m.testBit 4 || m.testBit 5 || m.testBit 6)) ||
  (m.testBit 2 && (m.testBit 3 || m.testBit 7 || m.testBit 8 || m.testBit 9))

def Port (b : Nat) : Prop := ∃ (inside : Nat → Bool) (outside : Nat → Bool → Bool),
  ∀ i o, i &&& b = i → o &&& b = 0 → graph (i ||| o) = outside o (inside i)

def Sep (b i p q : Nat) : Prop :=
  i &&& b = i ∧ p &&& b = 0 ∧ q &&& b = 0 ∧ graph p = false ∧ graph (b ||| p) = true ∧
  graph q = false ∧ graph (b ||| q) = true ∧ graph (i ||| p) ≠ graph (i ||| q)

instance (b i p q : Nat) : Decidable (Sep b i p q) := by unfold Sep; infer_instance

private theorem unary (a b c : Bool) (f g : Bool → Bool) (h0 : f a = false)
    (h1 : f b = true) (k0 : g a = false) (k1 : g b = true) : f c = g c := by
  cases a <;> cases b <;> cases c <;> simp_all

theorem sep_no_port {b i p q : Nat} (s : Sep b i p q) (h : Port b) : False := by
  obtain ⟨hi,hp,hq,h0,h1,k0,k1,ne⟩ := s
  obtain ⟨f,g,h⟩ := h
  have zp : graph p = g p (f 0) := by simpa using h 0 p (by simp) hp
  have zq : graph q = g q (f 0) := by simpa using h 0 q (by simp) hq
  have bp := h b p (by simp) hp
  have bq := h b q (by simp) hq
  apply ne
  rw [h i p hi hp,h i q hi hq]
  exact unary (f 0) (f b) (f i) (g p) (g q) (zp.symm.trans h0) (bp.symm.trans h1)
    (zq.symm.trans k0) (bq.symm.trans k1)

