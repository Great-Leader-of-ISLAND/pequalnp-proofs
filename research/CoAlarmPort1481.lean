def bitOfCode (k : Nat) : Nat := if k=0 then 0 else 1 <<< (k-1)
def Cert (b : Nat) : Prop :=
  let c := (blocks.getD (b/16) 0) >>> (12*(b % 16))
  b ∈ allowed ∨ Sep b (bitOfCode ((c >>> 8) % 16)) (bitOfCode (c % 16)) (bitOfCode ((c >>> 4) % 16))

instance (b : Nat) : Decidable (Cert b) := by unfold Cert; infer_instance

set_option maxRecDepth 10000 in
set_option maxHeartbeats 0 in
theorem finite_table : ∀ b : Fin 1024, Cert b.val := by decide +kernel

theorem port_mask {b : Fin 1024} (h : Port b.val) : b.val ∈ allowed := by
  rcases finite_table b with good | sep
  · exact good
  · exact (sep_no_port sep h).elim

#print axioms port_mask
end CoAlarmPort1481
