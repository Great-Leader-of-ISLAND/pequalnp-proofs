import Std

/-- All positive/negative assignment pairs of the seven-variable theta graph. -/
namespace CoThetaFreeSearch

abbrev Sig := Nat × Nat
def full : Nat := (1 <<< 2727) - 1
def goal : Sig := (full,0)
def zero : Sig := (0,0)
def sep (a : Sig) : Nat := a.1 ^^^ a.2
def unionSep (xs : List Sig) : Nat := xs.foldl (fun m a => m ||| sep a) 0

def gate (op : Nat) (a b : Sig) : Sig :=
  match op with
  | 0 => (a.1 &&& b.1,a.2 &&& b.2)
  | 1 => (a.1 ||| b.1,a.2 ||| b.2)
  | 2 => (a.1 &&& (full ^^^ b.1),a.2 &&& (full ^^^ b.2))
  | _ => (b.1 &&& (full ^^^ a.1),b.2 &&& (full ^^^ a.2))

def trial (k : Nat) (recur : List Sig → Bool) (ws rest : List Sig)
    (a b z : Sig) (other : Nat) : Bool :=
  if z == zero || ws.contains z then false else
    let cover := other ||| sep z
    let count := rest.length + 1
    (count ≤ k+1 && cover == full && recur (z::rest)) ||
    (count+1 ≤ k+1 && (cover ||| sep a) == full && recur (z::a::rest)) ||
    (count+1 ≤ k+1 && (cover ||| sep b) == full && recur (z::b::rest)) ||
    (count+2 ≤ k+1 && (cover ||| sep a ||| sep b) == full && recur (z::a::b::rest))

def withPair (k : Nat) (recur : List Sig → Bool) (ws rest : List Sig) (a b : Sig) : Bool :=
  let other := unionSep rest
  [0,1,2,3].any fun op => trial k recur ws rest a b (gate op a b) other

def pairs (f : Sig → Sig → List Sig → Bool) (seen : List Sig) : List Sig → Bool
  | [] => false
  | a::tail =>
    (tail.any fun b => f a b (seen ++ tail.erase b)) || pairs f (a::seen) tail

def search : Nat → List Sig → Bool
  | 0, ws => ws.contains goal
  | k+1, ws =>
    ws.contains goal || (ws.length ≤ k+2 &&
      pairs (fun a b rest => withPair k (search k) ws rest a b) [] ws)

def raw : List Sig := [
  (,),
  (,),
  (,),
  (,),
  (,),
  (,),
  (,)]

def firstOp (budget i j op : Nat) : Bool :=
  let a := raw[i]?.getD zero
  let b := raw[j]?.getD zero
  let rest := (raw.erase a).erase b
  trial (budget-1) (search (budget-1)) raw rest a b (gate op a b) (unionSep rest)

end CoThetaFreeSearch
