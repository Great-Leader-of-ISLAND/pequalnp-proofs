def splitRows (n : Nat) := (row (n/512),row (n % 512))

theorem one_charts : ∀ (j : Fin 6) (rev : Bool) (k : Fin 4) (sw : Bool),
  let t := splitRows (oneTable.getD (firstIndex j rev k sw) 0)
  oneRows (side j rev) (signedPair j k sw) t.1 t.2 := by decide +kernel

theorem two_charts : ∀ (j : Fin 6) (a b : Fin 4) (sa sb : Bool),
  let t := splitRows (twoTable.getD (bothIndex j a b sa sb) 0)
  twoRows (ep j) (eqp j) (signedPair j a sa) (signedPair j b sb) t.1 t.2 := by decide +kernel

theorem as_pair (j : Fin 6) (A : TraceGate Input)
    (p : reads A (vtx (ep j))) (q : reads A (vtx (eqp j))) :
    ∃ k sw, A.value=signedPair j k sw := by
  obtain ⟨sw,h⟩ := joint_reader_code _ _ (distinct_inputs (panel_data j).1) A p q
  refine ⟨kindId A.kind,sw,?_⟩
  funext r
  simpa only [signedPair,kind_back] using h r

theorem joint_second (j : Fin 6) (rev : Bool) {gs : List (TraceGate Input)}
    {A : TraceGate Input} (p : reads A (vtx (ep j))) (q : reads A (vtx (eqp j)))
    (ok : sufficient bank ans gs) : ∃ g∈gs, reads g (vtx (side j rev)) ∧ g≠A := by
  obtain ⟨k,sw,eq⟩ := as_pair j A p q
  apply another ok
  rw [eq]
  exact one_charts j rev k sw

theorem joint_third (j : Fin 6) {gs : List (TraceGate Input)} {A B : TraceGate Input}
    (aP : reads A (vtx (ep j))) (aQ : reads A (vtx (eqp j)))
    (bP : reads B (vtx (ep j))) (bQ : reads B (vtx (eqp j)))
    (ok : sufficient bank ans gs) :
    ∃ g∈gs, (reads g (vtx (ep j)) ∨ reads g (vtx (eqp j))) ∧ g≠A ∧ g≠B := by
  obtain ⟨ka,sa,ea⟩ := as_pair j A aP aQ
  obtain ⟨kb,sb,eb⟩ := as_pair j B bP bQ
  apply third ok
  rw [ea,eb]
  exact two_charts j ka kb sa sb

theorem single_exists (j : Fin 6) (rev : Bool) {gs : List (TraceGate Input)}
    (ok : sufficient bank ans gs) : ∃ g∈gs, reads g (vtx (side j rev)) := by
  let t := splitRows (oneTable.getD (firstIndex j rev 0 false) 0)
  have test : oneRows (side j rev) (signedPair j 0 false) t.1 t.2 := one_charts j rev 0 false
  obtain ⟨g,hg,reader,_⟩ := reader_witness (·=vtx (side j rev)) t.1 t.2 ok.1
    (oneAgree test.1 test.2.1) ok.2 (not_input _) test.2.2.1
  exact ⟨g,hg,reader⟩

theorem three_pair (j : Fin 6) {gs : List (TraceGate Input)}
    (ok : sufficient bank ans gs)
    (known : (∃ A∈gs, ∃ B∈gs, reads A (vtx (ep j)) ∧ reads B (vtx (ep j)) ∧ A≠B) ∨
             (∃ A∈gs, ∃ B∈gs, reads A (vtx (eqp j)) ∧ reads B (vtx (eqp j)) ∧ A≠B)) :
    ThreeReaders (fun g => reads g (vtx (ep j)) ∨ reads g (vtx (eqp j))) gs := by
  classical
  have ne := (panel_data j).1
  by_cases shared : ∃ J∈gs, reads J (vtx (ep j)) ∧ reads J (vtx (eqp j))
  · obtain ⟨J,hJ,Jp,Jq⟩ := shared
    obtain ⟨A,hA,Ap,AJ⟩ := joint_second j false Jp Jq ok
    obtain ⟨B,hB,Bq,BJ⟩ := joint_second j true Jp Jq ok
    by_cases e : A=B
    · subst B
      obtain ⟨C,hC,read,CJ,CA⟩ := joint_third j Jp Jq Ap Bq ok
      exact ⟨J,hJ,A,hA,C,hC,Or.inl Jp,Or.inl Ap,read,AJ.symm,CJ.symm,CA.symm⟩
    · exact ⟨J,hJ,A,hA,B,hB,Or.inl Jp,Or.inl Ap,Or.inr Bq,AJ.symm,BJ.symm,e⟩
  · rcases known with ⟨A,hA,B,hB,Ap,Bp,AB⟩|⟨A,hA,B,hB,Aq,Bq,AB⟩
    · obtain ⟨C,hC,Cq⟩ := single_exists j true ok
      exact ⟨A,hA,B,hB,C,hC,Or.inl Ap,Or.inl Bp,Or.inr Cq,AB,
        fun e => shared ⟨A,hA,Ap,e ▸ Cq⟩,fun e => shared ⟨B,hB,Bp,e ▸ Cq⟩⟩
    · obtain ⟨C,hC,Cp⟩ := single_exists j false ok
      exact ⟨A,hA,B,hB,C,hC,Or.inr Aq,Or.inr Bq,Or.inl Cp,AB,
        fun e => shared ⟨A,hA,e ▸ Cp,Aq⟩,fun e => shared ⟨B,hB,e ▸ Cp,Bq⟩⟩


