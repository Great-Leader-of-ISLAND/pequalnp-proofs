def plan (c : Nat) := decisions.getD c 0
def jplan (c : Nat) : Fin 6 := ⟨((plan c-12)/2) % 6,Nat.mod_lt _ (by decide)⟩
def flip (c : Nat) := (plan c-12) % 2 == 1
def corrected (c : Nat) := replacements.getD c c
def canonical (c : Nat) := decodeHead (corrected c)

theorem number_back : ∀ (a b : Fin 10) (k : Fin 4),
    (numberHead a b k)/40=a.val ∧ ((numberHead a b k)/4) % 10=b.val ∧ (numberHead a b k) % 4=k.val := by decide
theorem kind_num (k : Fin 4) : (⟨k.val % 4,Nat.mod_lt _ (by decide)⟩ : Fin 4)=k :=
  Fin.ext (Nat.mod_eq_of_lt k.isLt)
theorem decoded (a b : Fin 10) (k : Fin 4) :
    decodeHead (numberHead a b k)=⟨kind k,rawWord a.val,rawWord b.val⟩ := by
  rcases number_back a b k with ⟨h1,h2,h3⟩
  simp only [decodeHead,h1,h2,h3,makeHead,kind_num]
theorem raw_word (i : Fin 9) : rawWord i.val=vtx i := by
  fin_cases i <;> rfl
theorem raw_present : ∀ i : Fin 11, rawWord i.val∈bank := by
  intro i
  by_cases hi : i.val<9
  · apply List.mem_cons_of_mem
    apply List.mem_cons_of_mem
    exact List.mem_ofFn.mpr ⟨⟨i.val,hi⟩,(raw_word ⟨i.val,hi⟩).symm⟩
  · by_cases eq : i.val=9
    · simpa [rawWord,hi,eq,bank] using (List.mem_cons_self : seed∈seed::vertices)
    · simpa [rawWord,hi,eq] using (List.mem_cons_of_mem seed List.mem_cons_self : absentBit∈bank)
theorem find_raw {w : Input→Bool} (h : w∈bank) (nz : w≠absentBit) :
    ∃ a : Fin 10, w=rawWord a.val := by
  rcases List.mem_cons.mp h with e|h
  · exact ⟨9,e⟩
  rcases List.mem_cons.mp h with e|h
  · exact (nz e).elim
  obtain ⟨i,e⟩ := List.mem_ofFn.mp h
  exact ⟨⟨i.val,by omega⟩,e.symm.trans (raw_word i).symm⟩
theorem canon_valid : ∀ c : Fin 400, corrected c.val<400 := by decide +kernel
theorem canon_equal : ∀ c : Fin 400, ∀ r : Input,
    (canonical c.val).value r=(decodeHead c.val).value r := by decide +kernel
theorem small_plan : ∀ c : Fin 400, plan c.val<11 →
    ∀ r : Input, (decodeHead c.val).value r=rawWord (plan c.val) r := by decide +kernel
theorem exceptional : ∀ c : Fin 400, plan c.val=11 →
    corrected c.val=4 := by decide +kernel
theorem marked_plan : ∀ c : Fin 400, 12≤plan c.val →
    let j := jplan c.val
    let rev := flip c.val
    let i := corrected c.val
    let t := splitRows (headRows.getD c.val 0)
    ((i/40= (side j rev).val) ∨ ((i/4) % 10= (side j rev).val)) ∧
    oneRows (side j rev) (canonical c.val).value t.1 t.2 := by decide +kernel

theorem canon_ports {c : Fin 400} : (canonical c.val).left∈bank ∧ (canonical c.val).right∈bank := by
  have bound := canon_valid c
  exact ⟨raw_present ⟨_,by omega⟩,raw_present ⟨_,by omega⟩⟩

theorem read_side (c : Fin 400) (big : 12≤plan c.val) :
    reads (canonical c.val) (vtx (side (jplan c.val) (flip c.val))) := by
  obtain ⟨left|right,_⟩ := marked_plan c big
  · exact Or.inl ((congrArg rawWord left).trans (raw_word _))
  · exact Or.inr ((congrArg rawWord right).trans (raw_word _))

theorem three_when_marked (c : Fin 400) (big : 12≤plan c.val) (gs : List (TraceGate Input))
    (ok : sufficient bank ans (canonical c.val::gs)) :
    ThreeReaders (fun t => reads t (vtx (ep (jplan c.val))) ∨ reads t (vtx (eqp (jplan c.val)))) (canonical c.val::gs) := by
  let j := jplan c.val
  let rev := flip c.val
  obtain ⟨g,hg,read,ne⟩ := another ok (marked_plan c big).2
  have h := read_side c big
  apply three_pair j ok
  cases sr : flip c.val with
  | false =>
    rw [sr] at h read
    exact Or.inl ⟨_,List.mem_cons_self,g,hg,h,read,ne.symm⟩
  | true =>
    rw [sr] at h read
    exact Or.inr ⟨_,List.mem_cons_self,g,hg,h,read,ne.symm⟩

theorem and_signal : twoRows 0 1 (decodeHead 4).value (decodeHead 4).value (row 5) (row 6) := by decide +kernel

theorem three_when_and (gs : List (TraceGate Input)) (ok : sufficient bank ans (decodeHead 4::gs)) :
    ∃ j : Fin 6, ThreeReaders (fun t => reads t (vtx (ep j)) ∨ reads t (vtx (eqp j))) (decodeHead 4::gs) := by
  obtain ⟨b,hb,r,ne,_⟩ := third ok and_signal
  rcases r with hp|hq
  · refine ⟨0,three_pair 0 ok (Or.inl ⟨_,List.mem_cons_self,b,hb,Or.inl rfl,hp,ne.symm⟩)⟩
  · refine ⟨1,three_pair 1 ok (Or.inl ⟨_,List.mem_cons_self,b,hb,Or.inr rfl,hq,ne.symm⟩)⟩

theorem first_three {g : TraceGate Input} {ts} (ok : sufficient bank ans (g::ts)) (fresh : g.value∉bank) :
    ∃ (h : TraceGate Input) (j : Fin 6), h.value=g.value ∧ sufficient bank ans (h::ts) ∧
      ThreeReaders (fun t => reads t (vtx (ep j)) ∨ reads t (vtx (eqp j))) (h::ts) := by
  obtain ⟨pl,pr, _⟩ := fresh_ports g ok.1.1 ok.1.2.1 (show absentBit∈bank from raw_present 10) fresh
  obtain ⟨a,ea⟩ := find_raw ok.1.1 pl
  obtain ⟨b,eb⟩ := find_raw ok.1.2.1 pr
  let c : Fin 400 := ⟨numberHead a b (kindId g.kind), by
    have ha := a.isLt
    have hb := b.isLt
    have hk := (kindId g.kind).isLt
    dsimp [numberHead]
    omega⟩
  have eq : decodeHead c.val=g := by
    rw [show c.val=numberHead a b (kindId g.kind) from rfl,decoded,kind_back,←ea,←eb]
  by_cases low : plan c.val<11
  · apply False.elim
    apply fresh
    have e := funext (small_plan c low)
    rw [eq] at e
    exact e ▸ raw_present ⟨_,low⟩
  have he : (canonical c.val).value=g.value := (funext (canon_equal c)).trans (congrArg TraceGate.value eq)
  have ok' : sufficient bank ans (canonical c.val::ts) := by
    refine ⟨⟨canon_ports.1,canon_ports.2,?_⟩,?_⟩
    · rw [he]
      exact ok.1.2.2
    · change ans∈traceWires ((canonical c.val).value::bank) ts
      rw [he]
      exact ok.2
  by_cases special : plan c.val=11
  · have hg : canonical c.val=decodeHead 4 := congrArg decodeHead (exceptional c special)
    obtain ⟨j,test⟩ := three_when_and ts (hg ▸ ok')
    exact ⟨_,j,he,ok',by simpa only [hg] using test⟩
  · exact ⟨_,jplan c.val,he,ok',three_when_marked c (by omega) ts ok'⟩

