def seed (r : Input) := vtx 0 r || vtx 1 r
def bank : List (Input→Bool) := seed::vertices

def kind (n : Fin 4) : Kind := match n.val with
  | 0 => .conj | 1 => .disj | 2 => .leftOnly | _ => .rightOnly
def kindId : Kind → Fin 4
  | .conj => 0 | .disj => 1 | .leftOnly => 2 | .rightOnly => 3
theorem kind_back (k : Kind) : kind (kindId k)=k := by cases k <;> rfl

def signedPair (j : Fin 6) (k : Fin 4) (sw : Bool) : Input→Bool := fun r =>
  pairCode (kind k) sw (vtx (ep j) r) (vtx (eqp j) r)
def side (j : Fin 6) (rev : Bool) : Fin 9 := if rev then eqp j else ep j

def oneRows (p : Fin 9) (f : Input→Bool) (r s : Input) : Prop :=
  seed r=seed s ∧ (∀ i : Fin 9, i≠p → vtx i r=vtx i s) ∧ ans r≠ans s ∧ f r=f s
def twoRows (p q : Fin 9) (f g : Input→Bool) (r s : Input) : Prop :=
  seed r=seed s ∧ (∀ i : Fin 9, i≠p → i≠q → vtx i r=vtx i s) ∧ ans r≠ans s ∧ f r=f s ∧ g r=g s

theorem oneAgree {p : Fin 9} {r s : Input} (se : seed r=seed s)
    (fix : ∀ i : Fin 9, i≠p → vtx i r=vtx i s) : agreeOutside (·=vtx p) r s bank := by
  intro w hw ne
  rcases List.mem_cons.mp hw with e|rest
  · exact e ▸ se
  apply agree_on_vertices _ r s _ w rest ne
  intro i ni
  exact fix i (fun e => ni (congrArg vtx e))

theorem twoAgree {p q : Fin 9} {r s : Input} (se : seed r=seed s)
    (fix : ∀ i : Fin 9, i≠p → i≠q → vtx i r=vtx i s) :
    agreeOutside (fun w => w=vtx p ∨ w=vtx q) r s bank := by
  intro w hw ne
  rcases List.mem_cons.mp hw with e|rest
  · exact e ▸ se
  apply agree_on_vertices _ r s _ w rest ne
  intro i ni
  exact fix i (fun e => ni (Or.inl (congrArg vtx e))) (fun e => ni (Or.inr (congrArg vtx e)))

theorem another {p : Fin 9} {gs : List (TraceGate Input)} {g : TraceGate Input}
    (ok : sufficient bank ans gs) {r s} (test : oneRows p g.value r s) :
    ∃ h∈gs, reads h (vtx p) ∧ h≠g :=
  second_reader (vtx p) r s g ok.1 (oneAgree test.1 test.2.1) ok.2
    (not_input p) test.2.2.1 test.2.2.2

theorem third {p q : Fin 9} {gs : List (TraceGate Input)} {a b : TraceGate Input}
    (ok : sufficient bank ans gs) {r s} (test : twoRows p q a.value b.value r s) :
    ∃ h∈gs, (reads h (vtx p) ∨ reads h (vtx q)) ∧ h≠a ∧ h≠b := by
  rcases test with ⟨se,fix,diff,ca,cb⟩
  obtain ⟨g,hg,reader,changed⟩ := reader_witness (fun w => w=vtx p ∨ w=vtx q) r s ok.1
    (twoAgree se fix) ok.2 (fun hp => hp.elim (not_input p) (not_input q)) diff
  refine ⟨g,hg,?_,fun e => changed (e ▸ ca),fun e => changed (e ▸ cb)⟩
  rcases reader with (h|h)|(h|h)
  · exact Or.inl (Or.inl h)
  · exact Or.inr (Or.inl h)
  · exact Or.inl (Or.inr h)
  · exact Or.inr (Or.inr h)

def firstIndex (j : Fin 6) (rev : Bool) (k : Fin 4) (sw : Bool) :=
  ((j.val*2+rev.toNat)*4+k.val)*2+sw.toNat
def bothIndex (j : Fin 6) (a b : Fin 4) (sa sb : Bool) :=
  (((j.val*4+a.val)*2+sa.toNat)*4+b.val)*2+sb.toNat

